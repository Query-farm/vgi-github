  "scope": "connected pilot",
  "scopes": {
    "organizations": {
      "comment": "Require an explicit organization scope for organization, membership and team entities.",
      "exclusive_parameters": [
        "organization"
      ],
      "select": {
        "arguments": {
          "organization": {
            "parameter": "organization"
          }
        },
        "entity": "organization_lookup"
      }
    },
    "pull_requests": {
      "comment": "A PR number narrows one repository to one PR. Without it, include all current open and closed PR records.",
      "requires_parameters": {
        "pull_request_number": [
          "repository"
        ]
      },
      "select": {
        "if_absent": {
          "arguments": {
            "repository": {
              "column": "repository",
              "stage": "repositories"
            }
          },
          "entity": "pull_request_list"
        },
        "if_present": {
          "arguments": {
            "pull_request_number": {
              "parameter": "pull_request_number"
            },
            "repository": {
              "column": "repository",
              "stage": "repositories"
            }
          },
          "entity": "pull_request_lookup"
        },
        "parameter": "pull_request_number"
      }
    },
    "repositories": {
      "comment": "Choose exactly one repository, owner or organization. Organization listings follow credential visibility; user-owner listings contain public owned repositories only.",
      "exclusive_parameters": [
        "owner",
        "repository",
        "organization"
      ],
      "select": {
        "if_absent": {
          "if_absent": {
            "cases": {
              "Organization": {
                "arguments": {
                  "owner": {
                    "parameter": "owner"
                  }
                },
                "entity": "organization_repositories"
              },
              "User": {
                "arguments": {
                  "owner": {
                    "parameter": "owner"
                  }
                },
                "entity": "user_repositories"
              }
            },
            "field": "account_type",
            "resolve": {
              "arguments": {
                "owner": {
                  "parameter": "owner"
                }
              },
              "entity": "account_lookup"
            }
          },
          "if_present": {
            "arguments": {
              "owner": {
                "parameter": "organization"
              }
            },
            "entity": "organization_repositories"
          },
          "parameter": "organization"
        },
        "if_present": {
          "arguments": {
            "repository": {
              "parameter": "repository"
            }
          },
          "entity": "repository_lookup"
        },
        "parameter": "repository"
      }
    },
    "users": {
      "comment": "Require a personal user account; an organization login is not a user activity scope.",
      "select": {
        "cases": {
          "User": {
            "arguments": {
              "user": {
                "parameter": "user"
              }
            },
            "entity": "user_profile_lookup"
          }
        },
        "field": "account_type",
        "resolve": {
          "arguments": {
            "owner": {
              "parameter": "user"
            }
          },
          "entity": "account_lookup"
        }
      }
    }
  },
