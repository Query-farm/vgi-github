@@ -0,0 +1,36 @@
+-- Run after attaching vgi-github/tests/crossfield/worker_fixture.py as github
+-- with reporting=true. All comparisons are independent fixture expectations.
+SELECT 'repositories', CASE WHEN count(*)=2 AND sum(stargazers_count)=24 THEN 'ok' ELSE error('repositories') END
+FROM github.main.repos('example', max_rows=>0);
+SELECT 'repo', CASE WHEN count(*)=1 AND max(topics)=['sql','semantic'] THEN 'ok' ELSE error('repo') END
+FROM github.main.repo('example/project');
+SELECT 'user', CASE WHEN count(*)=1 AND max(followers)=5 THEN 'ok' ELSE error('user') END
+FROM github.main.user('alice');
+SELECT 'issues', CASE WHEN count(*)=2 THEN 'ok' ELSE error('issues') END
+FROM github.main.issues('example/project', max_rows=>0);
+SELECT 'pulls', CASE WHEN count(*)=4 AND avg(date_diff('millisecond',created_at,merged_at)/3600000.0)=9
+AND median(date_diff('millisecond',created_at,merged_at)/3600000.0)=7
+AND quantile_cont(date_diff('millisecond',created_at,merged_at)/3600000.0,0.9)=17
+THEN 'ok' ELSE error('pulls') END
+FROM github.main.pulls('example/project',state=>'closed',max_rows=>0)
+WHERE merged_at>=TIMESTAMPTZ '2026-09-01' AND merged_at<TIMESTAMPTZ '2026-10-01';
+SELECT 'comments', CASE WHEN count(*)=1 THEN 'ok' ELSE error('comments') END
+FROM github.main.issue_comments('example/project',1,max_rows=>0);
+SELECT 'commits', CASE WHEN count(*)=2 AND count(*) FILTER(WHERE is_verified)=1 THEN 'ok' ELSE error('commits') END
+FROM github.main.commits('example/project',max_rows=>0);
+SELECT 'releases', CASE WHEN count(*)=1 AND sum(download_count)=35 THEN 'ok' ELSE error('releases') END
+FROM github.main.releases('example/project',max_rows=>0);
+SELECT 'contributors', CASE WHEN count(*)=2 AND sum(contributions)=10 THEN 'ok' ELSE error('contributors') END
+FROM github.main.contributors('example/project',max_rows=>0);
+SELECT 'languages', CASE WHEN count(*)=2 AND sum(bytes)=1000 THEN 'ok' ELSE error('languages') END
+FROM github.main.languages('example/project');
+SELECT 'stargazers', CASE WHEN count(*)=2 THEN 'ok' ELSE error('stargazers') END
+FROM github.main.stargazers('example/project',max_rows=>0);
+SELECT 'workflow_runs', CASE WHEN count(*)=3 AND count(*) FILTER(WHERE conclusion='failure')=1 THEN 'ok' ELSE error('workflow_runs') END
+FROM github.main.workflow_runs('example/project',max_rows=>0);
+SELECT 'search_repositories', CASE WHEN count(*)=2 THEN 'ok' ELSE error('search_repositories') END
+FROM github.main.search_repositories('org:example');
+SELECT 'search_issues', CASE WHEN count(*)=2 THEN 'ok' ELSE error('search_issues') END
+FROM github.main.search_issues('repo:example/project');
+SELECT 'rate_limit', CASE WHEN count(*)=2 AND sum(remaining)=64 THEN 'ok' ELSE error('rate_limit') END
+FROM github.main.all_rate_limit();
