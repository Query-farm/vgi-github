+optional<Value> ParameterDefault(const vgi::VgiFunctionInfo &info, const string &name,
+                                 const LogicalType &type) {
+	if (info.parameter_default_values_bytes.empty()) {
+		return {};
+	}
+	auto batch = vgi::DeserializeFromIpcBytes(info.parameter_default_values_bytes);
+	if (!batch || batch->num_rows() != 1) {
+		throw InvalidInputException("VGI parameter defaults must contain exactly one row: %s", info.name);
+	}
+	auto array = batch->GetColumnByName(name);
+	if (!array) {
+		return {};
+	}
+	if (array->IsNull(0)) {
+		return Value(type);
+	}
+	Value value;
+	switch (array->type_id()) {
+	case arrow::Type::BOOL:
+		value = Value::BOOLEAN(std::static_pointer_cast<arrow::BooleanArray>(array)->Value(0));
+		break;
+	case arrow::Type::INT32:
+		value = Value::INTEGER(std::static_pointer_cast<arrow::Int32Array>(array)->Value(0));
+		break;
+	case arrow::Type::INT64:
+		value = Value::BIGINT(std::static_pointer_cast<arrow::Int64Array>(array)->Value(0));
+		break;
+	case arrow::Type::DOUBLE:
+		value = Value::DOUBLE(std::static_pointer_cast<arrow::DoubleArray>(array)->Value(0));
+		break;
+	case arrow::Type::STRING:
+		value = Value(std::static_pointer_cast<arrow::StringArray>(array)->GetString(0));
+		break;
+	default:
+		throw NotImplementedException("VGI DuckDB 2 profile does not support this default type for %s.%s",
+		                              info.name, name);
+	}
+	if (value.type() != type) {
+		throw InvalidInputException("VGI parameter default type differs from its declaration: %s.%s", info.name, name);
+	}
+	return value;
+}
