+++ b/src/vgi_scalar_duckdb2_profile.cpp
@@ -0,0 +1,196 @@
+// © Copyright 2026 Query Farm LLC - https://query.farm
+// Narrow synchronous fixed-schema scalar profile for the pinned DuckDB 2 host.
+// Reuses the VGI transport and Arrow engine; no result memoization or input
+// deduplication is enabled in this interoperability profile.
+#include "vgi_scalar_function_impl.hpp"
+#include "storage/vgi_transaction.hpp"
+#include "vgi_arrow_utils.hpp"
+#include "vgi_batch_validation.hpp"
+#include "vgi_function_connection.hpp"
+#include "vgi_ifunction_connection.hpp"
+#include "vgi_logging.hpp"
+#include "vgi_worker_pool.hpp"
+#include "duckdb/common/vector_operations/vector_operations.hpp"
+#include "duckdb/function/table/arrow.hpp"
+#include "duckdb/main/client_context.hpp"
+#include "duckdb/planner/expression/bound_function_expression.hpp"
+#include <exception>
+
+namespace duckdb {
+VgiScalarFunctionLocalState::VgiScalarFunctionLocalState() = default;
+VgiScalarFunctionLocalState::~VgiScalarFunctionLocalState() {
+	if (!connection || !initialized) {
+		return;
+	}
+	try {
+		if (!connection->IsFinished()) {
+			connection->CloseInputWriter();
+			if (connection->ReadDataBatch()) {
+				// Extra output violates the scalar protocol. Never pool that stream.
+				return;
+			}
+		}
+		if (use_pool) {
+			if (auto pooled = connection->ReleaseForPooling()) {
+				vgi::VgiWorkerPool::Instance().Release(std::move(pooled));
+			}
+		}
+	} catch (...) {
+		// Failure/cancellation destroys the connection; destructors do not throw.
+	}
+}
+
+namespace vgi {
+unique_ptr<FunctionLocalState> VgiScalarFunctionInitLocalState(ExpressionState &, const BoundFunctionExpression &,
+                                                            FunctionData *) {
+	return make_uniq<VgiScalarFunctionLocalState>();
+}
+
+static void CheckSchema(ClientContext &context, const std::shared_ptr<arrow::Schema> &schema,
+                        const LogicalType &expected, const string &function_name) {
+	if (!schema || schema->num_fields() != 1) {
+		throw IOException("VGI scalar '%s' requires exactly one output column", function_name);
+	}
+	ArrowSchemaWrapper c_schema;
+	ArrowTableSchema table;
+	vector<LogicalType> types;
+	vector<string> names;
+	ArrowSchemaToDuckDBTypes(context, schema, c_schema, table, types, names);
+	if (types.size() != 1 || types[0] != expected) {
+		throw IOException("VGI scalar '%s' changed its fixed result type", function_name);
+	}
+}
+
+// Binding only constructs native metadata. Provider bind/init are deferred to
+// the first nonempty execution batch. Native SQL constant folding can still
+// execute a consistent scalar; Crossfield's private wrapper supplies its
+// separate compile/explain nonexecution boundary.
+unique_ptr<FunctionData> VgiScalarFunctionBind(BindScalarFunctionInput &input) {
+	auto &context = input.GetClientContext();
+	auto &function = input.GetBoundFunction();
+	auto &info = function.GetExtraFunctionInfo().Cast<VgiScalarFunctionInfo>();
+	if (info.global || !info.catalog || info.has_dynamic_return_type ||
+	    function.GetArguments().size() != input.GetArguments().size()) {
+		throw NotImplementedException("VGI DuckDB 2 scalar profile requires a catalog-owned fixed signature");
+	}
+	auto data = make_uniq<VgiScalarFunctionBindData>();
+	data->attach_params = info.attach_params;
+	data->attach_opaque_data = info.attach_opaque_data;
+	data->function_name = info.function_name;
+	data->schema_name = info.schema_name;
+	data->settings = ExtractVgiSettings(context, info.setting_names);
+	data->required_secrets = info.required_secrets;
+	data->resolved_output_schema = info.output_schema;
+	data->input_duckdb_types = function.GetArguments();
+	vector<string> names;
+	std::vector<std::optional<std::string>> argument_names;
+	for (idx_t i = 0; i < data->input_duckdb_types.size(); ++i) {
+		if (data->input_duckdb_types[i].id() == LogicalTypeId::ANY ||
+		    data->input_duckdb_types[i].id() == LogicalTypeId::INVALID) {
+			throw NotImplementedException("VGI DuckDB 2 scalar profile requires concrete argument types");
+		}
+		auto name = i < info.positional_names.size() ? info.positional_names[i] : "col_" + std::to_string(i);
+		names.push_back(name);
+		argument_names.emplace_back(name);
+	}
+	data->argument_names = std::move(argument_names);
+	data->input_schema = BuildArrowSchemaFromDuckDB(context, data->input_duckdb_types, names);
+	CheckSchema(context, data->resolved_output_schema, function.GetReturnType(), info.function_name);
+	return data;
+}
+
+void VgiScalarFunctionExecute(DataChunk &args, ExpressionState &state, Vector &result) {
+	if (args.size() == 0) {
+		return;
+	}
+	auto &context = state.GetContext();
+	if (context.IsInterrupted()) {
+		throw InterruptException();
+	}
+	auto &expression = state.expr.Cast<BoundFunctionExpression>();
+	auto &info = expression.Function().GetExtraFunctionInfo().Cast<VgiScalarFunctionInfo>();
+	auto &data = expression.BindInfo()->Cast<VgiScalarFunctionBindData>();
+	auto &local = ExecuteFunctionState::GetFunctionState(state)->Cast<VgiScalarFunctionLocalState>();
+	struct FailedExchange {
+		VgiScalarFunctionLocalState &state;
+		int exceptions = std::uncaught_exceptions();
+		~FailedExchange() {
+			if (std::uncaught_exceptions() > exceptions) {
+				// A failed stream is never drained or offered to the worker pool.
+				state.initialized = false;
+				state.connection.reset();
+			}
+		}
+	} failure {local};
+	if (!local.initialized) {
+		auto arguments = BuildArgumentsFromValues(context, {}, {});
+		auto transaction = VgiTransaction::Get(context, *info.catalog).GetTransactionOpaqueData();
+		std::unique_ptr<IFunctionConnection> connection;
+		if (data.use_pool()) {
+			PoolKey key {data.worker_path(), data.data_version_spec(), data.implementation_version()};
+			if (auto pooled = VgiWorkerPool::Instance().TryAcquire(key)) {
+				connection = CreateFunctionConnectionFromPool(std::move(pooled), data.function_name, arguments,
+				    data.attach_opaque_data, transaction, context, "SCALAR", {}, data.worker_debug(), data.settings,
+				    data.required_secrets);
+			}
+		}
+		if (!connection) {
+			connection = CreateFunctionConnection(data.worker_path(), data.function_name, arguments,
+			    data.attach_opaque_data, transaction, context, "SCALAR", {}, data.worker_debug(), data.settings,
+			    data.required_secrets, data.attach_params);
+		}
+		connection->SetInputSchema(data.input_schema);
+		connection->SetSchemaName(data.schema_name);
+		connection->SetArgumentNames(data.argument_names);
+		auto bound = connection->PerformBindRpc();
+		CheckSchema(context, bound.output_schema, result.GetType(), data.function_name);
+		connection->PerformInit(bound);
+		connection->OpenInputWriter();
+		local.connection = std::move(connection);
+		local.initialized = true;
+		local.use_pool = data.use_pool();
+		VGI_LOG(context, "scalar.init", {{"function_name", data.function_name}});
+	}
+	if (args.ColumnCount() != data.input_duckdb_types.size()) {
+		throw InternalException("VGI scalar argument count changed after binding");
+	}
+	DataChunk input;
+	input.Initialize(Allocator::Get(context), data.input_duckdb_types, args.size());
+	input.SetCardinalityUnsafe(args.size());
+	for (idx_t i = 0; i < args.ColumnCount(); ++i) {
+		if (args.data[i].GetType() == data.input_duckdb_types[i]) {
+			input.data[i].Reference(args.data[i]);
+		} else {
+			VectorOperations::DefaultCast(args.data[i], input.data[i], args.size());
+		}
+	}
+	VGI_LOG(context, "scalar.write_input", {{"function_name", data.function_name}, {"input_rows", std::to_string(args.size())}});
+	local.connection->WriteInputBatch(DataChunkToArrow(context, input, data.input_schema));
+	auto output = local.connection->ReadDataBatch();
+	if (!output || output->num_rows() != static_cast<int64_t>(args.size()) || output->num_columns() != 1) {
+		throw IOException("VGI scalar '%s' requires exactly one output row per input row", data.function_name);
+	}
+	VGI_LOG(context, "scalar.read_output", {{"function_name", data.function_name}, {"output_rows", std::to_string(output->num_rows())}});
+	// Required in this fixed-schema profile even when the general worker batch
+	// validation setting is disabled. Never read a mismatched Arrow buffer type.
+	ValidateWireBatchTypes(*output, {data.resolved_output_schema->field(0)->type()}, data.worker_path(), data.function_name);
+	auto validation = output->ValidateFull();
+	if (!validation.ok()) {
+		throw IOException("VGI scalar '%s' returned an invalid Arrow batch", data.function_name);
+	}
+	if (!local.output_schema_cached) {
+		ArrowSchemaToDuckDBTypes(context, data.resolved_output_schema, local.output_c_schema, local.output_arrow_table,
+		                        local.output_types, local.output_names);
+		local.output_schema_cached = true;
+	}
+	auto wrapper = make_uniq<ArrowArrayWrapper>();
+	ExportRecordBatch(output, *wrapper);
+	ArrowScanLocalState scan(std::move(wrapper), context);
+	DataChunk converted;
+	converted.Initialize(context, {result.GetType()});
+	converted.SetCardinalityUnsafe(args.size());
+	ArrowTableFunction::ArrowToDuckDB(scan, local.output_arrow_table.GetColumns(), converted, false);
+	result.Reference(converted.data[0]);
+}
+} // namespace vgi
+} // namespace duckdb
