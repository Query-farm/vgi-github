statement ok
SET crossfield_mode='off';

# The complete report really traverses multiple API pages. This only asserts
# traversal, not callback counts (DuckDB owns scheduling and reuse).
query I
SELECT count(*)>0 FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path='/repos/example/project/pulls' AND contains(query,'page=3');
----
true

query IIII
SELECT count(*) FILTER (WHERE path='/search/repositories' AND contains(query,'example-alpha'))>0,
       count(*) FILTER (WHERE path='/search/repositories' AND contains(query,'example-beta'))>0,
       count(*) FILTER (WHERE path='/search/issues' AND contains(query,'label%3Aalpha'))>0,
       count(*) FILTER (WHERE path='/search/issues' AND contains(query,'label%3Abeta'))>0
FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}');
----
true	true	true	true

# Every search GET must correspond to an actual requested query. A metadata
# placeholder, empty query, or fabricated witness is never an executable input.
query I
SELECT count(*) FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}')
WHERE (path='/search/repositories' AND NOT contains(query,'q=org%3Aexample'))
   OR (path='/search/issues' AND NOT contains(query,'q=repo%3Aexample%2Fproject'));
----
0

statement ok
