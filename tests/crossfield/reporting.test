# The real vgi-github worker with deterministic HTTP responses, executed through
# native DuckDB/VGI/Crossfield. See worker_fixture.py for the independent inputs.
# The runner loads VGI and Crossfield on init and exports these exact paths.
require crossfield

require json

require icu

require-env CROSSFIELD_GITHUB_PACKAGE

require-env CROSSFIELD_GITHUB_WORKER

require-env CROSSFIELD_GITHUB_API_LOG

statement ok
SET TimeZone='UTC';

# Seed a valid empty-request log before the worker starts; every real GET adds
# one JSON object. This also makes zero-request checks independent of inference.
statement ok
COPY (SELECT '' AS path, '' AS query) TO '{CROSSFIELD_GITHUB_API_LOG}' (FORMAT JSON);

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, auth 'off');

# Complete reporting cannot silently bind the exploratory 100-row/default
# behavior, or a provider with a different approved operation-timeout contract.
statement ok
ATTACH 'github' AS exploratory (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting false, auth 'off');

statement error
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS rejected (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"exploratory","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');
----
INVOCATION_METADATA_REQUIRED

statement ok
DETACH exploratory;

statement ok
ATTACH 'github' AS wrong_timeout (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, operation_timeout_seconds 119, auth 'off');

statement error
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS rejected (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"wrong_timeout","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');
----
INVOCATION_METADATA_REQUIRED

statement ok
DETACH wrong_timeout;

statement ok
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS engineering (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"github","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');

statement ok
SET crossfield_mode='strict';

query TTT
SELECT name,type,nullable::VARCHAR FROM crossfield_parameters() WHERE database_name='engineering' AND invocation_name='engineering.semantic.github' ORDER BY name;
----
comment_node_id	VARCHAR	false
discussion_number	BIGINT	false
issue_number	BIGINT	false
owner	VARCHAR	false
project_number	BIGINT	false
project_owner_type	VARCHAR	false
repository	VARCHAR	false

query I
SELECT count(*) FROM crossfield_queries() WHERE database_name='engineering';
----
49

query TTTT
SELECT name,type,nullable::VARCHAR,comment FROM crossfield_query_parameters() WHERE database_name='engineering' AND query_name='pr_merge_summary' ORDER BY ordinal;
----
repository	VARCHAR	false	Repository as 'owner/name'
start_day	DATE	false	Inclusive UTC calendar date.
end_day	DATE	false	Exclusive UTC calendar date.

query TT
SELECT name,type FROM crossfield_query_parameters() WHERE database_name='engineering' AND query_name='issue_comments_detail' ORDER BY ordinal;
----
repository	VARCHAR
issue_number	BIGINT

statement ok
PREPARE merge_cohort AS SELECT * FROM engineering.reports.pr_merge_summary(repository=>$1,start_day=>$2,end_day=>$3);

statement ok
PREPARE search_repos AS SELECT full_name,id FROM engineering.reports.search_repositories_detail(query=>$1) ORDER BY full_name;

statement ok
PREPARE search_issues AS SELECT number,state FROM engineering.reports.search_issues_detail(query=>$1) ORDER BY number;

statement ok
PREPARE semantic_merges AS SELECT merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>$1) WHERE pulls_merged_day >= $2::DATE AND pulls_merged_day < $3::DATE;

statement ok
EXPLAIN (SEMANTIC) SELECT pulls_user_login AS author,merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>'example/project') WHERE pulls_merged_day >= DATE '2026-09-01' AND pulls_merged_day < DATE '2026-10-01' GROUP BY pulls_user_login;

statement ok
EXPLAIN (SQL) SELECT repository_input_repo,merged_prs,workflow_run_count,ci_success_rate FROM engineering.semantic.github(repository=>'example/project') GROUP BY repository_input_repo;

statement ok
DESCRIBE SELECT merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>'example/project');

# Public inputs are model-owned. Required arguments depend on the selected
# metrics; unknown/unused arguments cannot silently look like effective filters.
statement error
SELECT merged_prs FROM engineering.semantic.github();
----
SEMANTIC_PARAMETER_MISSING

statement error
SELECT merged_prs FROM engineering.semantic.github(repository=>NULL);
----
SEMANTIC_PARAMETER_NULL

statement error
SELECT merged_prs FROM engineering.semantic.github(repository=>42);
----
SEMANTIC_PARAMETER_TYPE

statement error
SELECT merged_prs FROM engineering.semantic.github(repository=>'example/project',max_rows=>1);
----
SEMANTIC_PARAMETER_NAME

statement error
SELECT merged_prs FROM engineering.semantic.github(repository=>'example/project',owner=>'example');
----
SEMANTIC_PARAMETER_UNUSED

statement error
SELECT issue_comment_count FROM engineering.semantic.github(repository=>'example/project');
----
SEMANTIC_PARAMETER_MISSING

statement error
SELECT issue_comment_count FROM engineering.semantic.github(repository=>'example/project',issue_number=>'one');
----
SEMANTIC_PARAMETER_TYPE

statement error
SELECT merged_prs FROM engineering.semantic.github('example/project');
----
SEMANTIC_ARGUMENTS

statement error
SELECT merged_prs FROM engineering.semantic.github('example/project',repository=>'example/project');
----
<REGEX>:(?s).*(SEMANTIC_ARGUMENTS|named|positional).*

statement error
