WITH merges AS (SELECT merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>'example/project') WHERE pulls_merged_day >= DATE '2026-09-01' AND pulls_merged_day < DATE '2026-10-01') SELECT merged_prs,median_merge_hours,p90_merge_hours FROM merges;
----
4	7.000	17.000

