statement error
SELECT * FROM github.main.pulls('example/project');
----
RAW_SOURCE

statement error
SELECT ROUND(mean_merge_hours,2) FROM engineering.reports.pr_merge_summary(repository=>'example/project',start_day=>'2026-09-01',end_day=>'2026-10-01');
