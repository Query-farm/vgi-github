CROSSFIELD_REAGGREGATION

statement ok
SET crossfield_mode='off';

query T
SELECT name FROM crossfield_parameters() WHERE database_name='engineering' AND list_contains(source_datasets,'pulls') AND list_contains(metric_names,'merged_prs');
----
repository

query TTT
SELECT name,json_extract_string(requirements,'$.required_parameters'),json_extract_string(requirements,'$.requires_pipeline') FROM crossfield_catalog_capabilities() WHERE database_name='engineering' AND name IN ('merged_prs','repository_count') ORDER BY name;
----
merged_prs	["repository"]	false
repository_count	["owner"]	false

query I
SELECT count(*) FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path<>'';
----
0

query III
SELECT contains(metadata,'mean_merge_hours')::INTEGER,(json_extract_string(metadata,'$.model.name')='github')::INTEGER,contains(metadata,'live_explicit')::INTEGER FROM crossfield_compile('SELECT * FROM engineering.reports.pr_merge_summary(repository=>''example/project'',start_day=>''2026-09-01'',end_day=>''2026-10-01'')');
----
1	1	1

query I
SELECT count(*) FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path<>'';
----
0

statement ok
SET crossfield_mode='strict';

# Free metric composition keeps the caller's dimensions and population. These
# two authors have durations (2,10) and (4,20), respectively.
query TIRR
SELECT pulls_user_login AS author,merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>'example/project') WHERE pulls_merged_day >= DATE '2026-09-01' AND pulls_merged_day < DATE '2026-10-01' GROUP BY pulls_user_login ORDER BY author;
----
alice	2	6.000	9.200
bob	2	12.000	18.400

# Only the selected PR source may execute; metadata and unrelated metric
# sources (including owner/comment inputs) must not generate API requests.
statement ok
SET crossfield_mode='off';

query II
SELECT count(*) FILTER (WHERE path='/repos/example/project/pulls')>0,count(*) FILTER (WHERE path NOT IN ('','/repos/example/project/pulls')) FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}');
----
true	0

# The callable entry also works without strict-session enforcement.
query IRR
SELECT merged_prs,median_merge_hours,p90_merge_hours FROM engineering.semantic.github(repository=>'example/project') WHERE pulls_merged_day >= DATE '2026-09-01' AND pulls_merged_day < DATE '2026-10-01';
----
4	7.000	17.000

statement ok
SET crossfield_mode='strict';

