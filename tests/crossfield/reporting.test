statement ok
EXPLAIN (SQL) SELECT * FROM engineering.reports.pr_merge_summary(repository=>'example/project',start_day=>'2026-09-01',end_day=>'2026-10-01');

statement error
SELECT * FROM engineering.reports.pr_merge_summary(repository=>'example/project',start_day=>'2026-09-01');
----
<REGEX>:(?s).*(end_day|argument|parameter).*

statement error
