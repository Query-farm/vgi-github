# Independent August(31 days) -> September(30 days) activity oracle.
# Mocked HTTP exercises the real generated worker; no live-account claims.
require crossfield

require json

require icu

require-env CROSSFIELD_GITHUB_PACKAGE

require-env CROSSFIELD_GITHUB_WORKER

require-env CROSSFIELD_GITHUB_API_LOG

statement ok
SET TimeZone='UTC';

statement ok
COPY (SELECT '' AS path, '' AS query) TO '{CROSSFIELD_GITHUB_API_LOG}' (FORMAT JSON);

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, auth 'off');

statement ok
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS engineering (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"github","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');

statement ok
SET crossfield_mode='strict';

statement ok
EXPLAIN (SEMANTIC) SELECT authored_issue_count,authored_issue_active_days,authored_issue_repository_count FROM engineering.semantic.github(user=>'researcher');

statement ok
DESCRIBE SELECT * FROM engineering.detail.authored_discussion_comments(user=>'researcher');

statement ok
EXPLAIN (SQL) SELECT authored_commit_comment_created_month,authored_commit_comment_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_commit_comment_created_month;

statement ok
SET crossfield_mode='off';

query I
SELECT count(*) FROM read_ndjson_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path<>'';
----
0

statement ok
SET crossfield_mode='strict';

# Independent sources aggregate without multiplying each other's records.
query IIIIII
SELECT authored_pr_count,authored_issue_count,authored_discussion_count,authored_issue_comment_count,authored_discussion_comment_count,authored_commit_comment_count FROM engineering.semantic.github(user=>'researcher');
----
6	6	3	4	3	3

# Two explicit offsets cross UTC midnight in opposite directions. October 1
# is the exclusive upper boundary, rather than part of September's activity.
query TIIIR rowsort
SELECT authored_pr_created_month,authored_pr_count,authored_pr_active_days,authored_pr_repository_count,authored_median_merge_hours FROM engineering.semantic.github(user=>'researcher')
WHERE authored_pr_created_day>=DATE '2026-08-01' AND authored_pr_created_day<DATE '2026-10-01'
GROUP BY authored_pr_created_month;
----
2026-08-01	2	2	2	12.000
2026-09-01	3	2	2	18.000

# Prepared monthly queries keep the model timezone through native optimization.
# User inputs, date inputs and both together all use the same approved metrics.
statement ok
PREPARE monthly_user AS SELECT authored_pr_created_month,authored_pr_count,authored_pr_active_days,authored_pr_repository_count,authored_median_merge_hours
FROM engineering.semantic.github(user=>$1)
WHERE authored_pr_created_day>=DATE '2026-08-01' AND authored_pr_created_day<DATE '2026-10-01'
GROUP BY authored_pr_created_month ORDER BY authored_pr_created_month;

query TIIIR
EXECUTE monthly_user('researcher');
----
2026-08-01	2	2	2	12.000
2026-09-01	3	2	2	18.000

statement ok
PREPARE monthly_dates AS SELECT authored_pr_created_month,authored_pr_count,authored_pr_active_days,authored_pr_repository_count,authored_median_merge_hours
FROM engineering.semantic.github(user=>'researcher')
WHERE authored_pr_created_day>=$1 AND authored_pr_created_day<$2
GROUP BY authored_pr_created_month ORDER BY authored_pr_created_month;

query TIIIR
EXECUTE monthly_dates('2026-08-01','2026-10-01');
----
2026-08-01	2	2	2	12.000
2026-09-01	3	2	2	18.000

statement ok
