# Composition combines the six explicitly named event populations. This is a
# count of these visible authored records, not all GitHub actions or quality.
statement ok
SET crossfield_mode='semantic';

# Repository focus compares the two selected periods. A repository absent in
# August is new in this comparison, not necessarily new in the user's history.
query TIIIRRRI rowsort
WITH earlier AS (
 SELECT authored_repository_name AS repository,authored_pr_count AS contributions
 FROM engineering.semantic.github(user=>'researcher')
 WHERE authored_pr_created_day>=DATE '2026-08-01' AND authored_pr_created_day<DATE '2026-09-01'
 GROUP BY authored_repository_name
), later AS (
 SELECT authored_repository_name AS repository,authored_pr_count AS contributions
 FROM engineering.semantic.github(user=>'researcher')
 WHERE authored_pr_created_day>=DATE '2026-09-01' AND authored_pr_created_day<DATE '2026-10-01'
 GROUP BY authored_repository_name
), earlier_total AS (SELECT SUM(contributions) AS total FROM earlier),
   later_total AS (SELECT SUM(contributions) AS total FROM later)
SELECT COALESCE(e.repository,l.repository),COALESCE(e.contributions,0),COALESCE(l.contributions,0),
       COALESCE(l.contributions,0)-COALESCE(e.contributions,0),
       100.0*COALESCE(e.contributions,0)/NULLIF(et.total,0),
       100.0*COALESCE(l.contributions,0)/NULLIF(lt.total,0),
       100.0*(COALESCE(l.contributions,0)/NULLIF(lt.total,0)-COALESCE(e.contributions,0)/NULLIF(et.total,0)),
       (e.repository IS NULL)::INTEGER AS new_in_comparison
FROM earlier e FULL OUTER JOIN later l ON e.repository=l.repository CROSS JOIN earlier_total et CROSS JOIN later_total lt;
----
lab/compiler	1	1	0	50.0	33.33333333333333	-16.66666666666667	0
lab/sdk	0	2	2	0.0	66.66666666666667	66.66666666666667	1
outside/docs	1	0	-1	50.0	0.0	-50.0	0

statement ok
CREATE VIEW monthly_research_activity AS
WITH counts AS (
 SELECT authored_pr_created_month AS month,authored_pr_count AS events FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_pr_created_month
 UNION ALL SELECT authored_issue_created_month,authored_issue_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_issue_created_month
 UNION ALL SELECT authored_discussion_created_month,authored_discussion_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_discussion_created_month
 UNION ALL SELECT authored_issue_comment_created_month,authored_issue_comment_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_issue_comment_created_month
 UNION ALL SELECT authored_discussion_comment_created_month,authored_discussion_comment_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_discussion_comment_created_month
 UNION ALL SELECT authored_commit_comment_created_month,authored_commit_comment_count FROM engineering.semantic.github(user=>'researcher') GROUP BY authored_commit_comment_created_month
)
SELECT month,SUM(events) AS activity_count FROM counts WHERE month>=DATE '2026-08-01' AND month<DATE '2026-10-01' GROUP BY month;

query TI rowsort
SELECT month,activity_count FROM monthly_research_activity;
----
2026-08-01	9
2026-09-01	14

# Compare both totals and rates per calendar day; these months have unequal lengths.
query IIIRRR
WITH earlier AS (SELECT activity_count FROM monthly_research_activity WHERE month=DATE '2026-08-01'),
     later AS (SELECT activity_count FROM monthly_research_activity WHERE month=DATE '2026-09-01')
SELECT earlier.activity_count,later.activity_count,later.activity_count-earlier.activity_count,
       earlier.activity_count/31.0,later.activity_count/30.0,
       100.0*((later.activity_count/30.0)/(earlier.activity_count/31.0)-1)
FROM earlier CROSS JOIN later;
----
9	14	5	0.2903225806451613	0.4666666666666667	60.74074074074074

statement ok
DROP VIEW monthly_research_activity;

