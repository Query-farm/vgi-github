# Unknown repository evidence does not erase organization bypass requests.
require crossfield

require json

require icu

require-env CROSSFIELD_GITHUB_PACKAGE

require-env CROSSFIELD_GITHUB_WORKER

require-env CROSSFIELD_GITHUB_API_LOG

statement ok
SET TimeZone='UTC';

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, auth 'off');

statement ok
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS engineering (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"github","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');

statement ok
SET crossfield_mode='strict';

query IIIII
SELECT push_bypass_request_count,push_bypass_approved_count,push_bypass_pending_count,push_bypass_denied_count,push_bypass_response_count FROM engineering.semantic.github(organization=>'organization-bypass-fixture');
----
3	1	1	1	3

query TI
SELECT push_bypass_requests_repository,push_bypass_request_count FROM engineering.semantic.github(organization=>'organization-bypass-fixture') GROUP BY push_bypass_requests_repository ORDER BY push_bypass_requests_repository;
----
organization-bypass-fixture/alpha	1
organization-bypass-fixture/beta	1
NULL	1

query IIT
SELECT bypass_request_id,repository_id,repository FROM engineering.detail.push_bypass_requests(organization=>'organization-bypass-fixture') ORDER BY bypass_request_id;
----
53301	53201	organization-bypass-fixture/alpha
53302	NULL	NULL
53303	53202	organization-bypass-fixture/beta

query II
SELECT push_bypass_request_count,push_bypass_response_count FROM engineering.semantic.github(organization=>'organization-bypass-fixture',bypass_repository_name=>'alpha',bypass_reviewer=>'bypass-reviewer',bypass_requester=>'bypass-requester',bypass_time_period=>'month',bypass_request_status=>'approved');
----
1	2

query II
SELECT push_bypass_request_count,push_bypass_response_count FROM engineering.semantic.github(repository=>'organization-bypass-fixture/alpha');
----
1	2

statement ok
SET crossfield_mode='off';

statement ok
COPY (SELECT '' AS path, '' AS query) TO '{CROSSFIELD_GITHUB_API_LOG}' (FORMAT JSON);

statement ok
SET crossfield_mode='strict';

statement error
SELECT push_bypass_request_count FROM engineering.semantic.github(organization=>'organization-bypass-fixture',repository=>'organization-bypass-fixture/alpha');
----
Specify at most one

statement error
SELECT push_bypass_request_count FROM engineering.semantic.github(repository=>'organization-bypass-fixture/alpha',bypass_repository_name=>'alpha');
----
arguments do not apply

statement error
SELECT push_bypass_request_count FROM engineering.semantic.github(organization=>'organization-bypass-fixture',bypass_time_period=>'forever');
----
bypass_time_period

statement ok
SET crossfield_mode='off';

query I
SELECT count(*) FROM read_json_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path<>'';
----
0

statement ok
DETACH engineering;

statement ok
DETACH github;
