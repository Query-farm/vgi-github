# Copilot report metadata: counts describe available reports and signed links only.
require crossfield

require json

require icu

require-env CROSSFIELD_GITHUB_PACKAGE

require-env CROSSFIELD_GITHUB_WORKER

require-env CROSSFIELD_GITHUB_API_LOG

statement ok
SET TimeZone='UTC';

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, auth 'off');

statement ok
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS engineering (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"github","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');

statement ok
SET crossfield_mode='strict';

query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'organization_day',copilot_report_day=>'2026-09-01');
----
1	2

query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'repositories_day',copilot_report_day=>'2026-09-01');
----
1	1

query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'user_teams_day',copilot_report_day=>'2026-09-01');
----
1	0

query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'users_day',copilot_report_day=>'2026-09-01');
----
