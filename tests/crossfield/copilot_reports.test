query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'organization_latest');
----
1	1

query II
SELECT available_copilot_report_count,copilot_report_download_link_count FROM engineering.semantic.github(organization=>'copilot-report-fixture',copilot_report_kind=>'users_latest');
----
1	3

statement ok
CREATE TEMP TABLE copilot_reports_shape_1 AS SELECT * FROM engineering.detail.copilot_report_metadata(organization=>'copilot-report-fixture',copilot_report_kind=>'users_latest');

# Inspect materialized approved detail with normal DuckDB expressions.
statement ok
SET crossfield_mode='semantic';

query TTTI
SELECT report_start_day,report_end_day,requested_day,length(download_links) FROM copilot_reports_shape_1;
----
2026-08-05	2026-09-01	NULL	3

