query IIIR
SELECT pull_request_count,merged_prs,submitted_review_count,median_merge_hours FROM engineering.semantic.github(repository=>'example/empty');
----
0	0	0	NULL

query I
WITH cohort AS (SELECT merged_prs FROM engineering.semantic.github(owner=>'example')) SELECT merged_prs FROM cohort;
----
3

statement ok
PREPARE by_repository AS SELECT merged_prs FROM engineering.semantic.github(repository=>$1);

query I
EXECUTE by_repository('example/alpha');
----
2

query I
EXECUTE by_repository('example/empty');
----
0

# Callable detail has no saved report and retains author/reviewer role separation.
query IITTT
SELECT review_id,pull_request_number,author_login,reviewer_login,state FROM engineering.detail.pull_request_reviews(repository=>'example/alpha',pull_request_number=>1) ORDER BY review_id;
----
11	1	alice	bob	APPROVED
12	1	alice	alice	COMMENTED

query IT
SELECT review_id,reviewer_login FROM engineering.detail.pull_request_reviews(owner=>'example') ORDER BY review_id;
----
11	bob
12	alice
13	bob
21	carol

query IT
SELECT r.review_id,r."user".login FROM engineering.detail.pull_request_reviews(repository=>'example/beta') r;
----
21	carol

query T
SELECT name FROM engineering.detail.repository_labels(owner=>'example') ORDER BY name;
----
bug
feature
help

statement ok
PREPARE one_pr AS SELECT review_id FROM engineering.detail.pull_request_reviews(repository=>$1,pull_request_number=>$2) ORDER BY review_id;

query I
EXECUTE one_pr('example/beta',1);
----
21

