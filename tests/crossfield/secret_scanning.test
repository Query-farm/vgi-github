# Synthetic secret alerts: lifecycle, validity, location occurrences and scoped patterns.
require crossfield

require json

require icu

require-env CROSSFIELD_GITHUB_PACKAGE

require-env CROSSFIELD_GITHUB_WORKER

require-env CROSSFIELD_GITHUB_API_LOG

statement ok
SET TimeZone='UTC';

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{CROSSFIELD_GITHUB_WORKER}', reporting true, auth 'off');

statement ok
ATTACH '{CROSSFIELD_GITHUB_PACKAGE}' AS engineering (TYPE crossfield, BINDINGS '{"github_source":{"catalog":"github","provider_id":"queryfarm.vgi.github","instance_id":"github.com"}}');

statement ok
SET crossfield_mode='strict';

query IIIII
SELECT secret_scanning_alert_count,secret_scanning_open_alert_count,secret_scanning_resolved_alert_count,secret_scanning_active_alert_count,secret_scanning_bypassed_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha');
----
3	1	2	2	1

query IIII
SELECT secret_scanning_alert_count,secret_scanning_open_alert_count,secret_scanning_active_alert_count,secret_scanning_bypassed_alert_count FROM engineering.semantic.github(organization=>'secret-fixture');
----
4	2	2	2

# Resolved is not synonymous with inactive or revoked.
query TTI
SELECT secret_scanning_alerts_state,secret_scanning_alerts_validity,secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha') GROUP BY secret_scanning_alerts_state,secret_scanning_alerts_validity ORDER BY secret_scanning_alerts_state,secret_scanning_alerts_validity;
----
open	active	1
resolved	active	1
resolved	inactive	1

query I
SELECT secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_validity=>'active');
----
2

query I
SELECT secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_bypassed=>false);
----
2

query I
SELECT secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_publicly_leaked=>true);
----
1

query I
SELECT secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_providers=>'github');
----
2

query TTT
SELECT assigned_to_login,push_protection_bypassed_by_login,push_protection_bypass_request_reviewer_login FROM engineering.detail.secret_scanning_alerts(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>1,secret_scanning_hide_secret=>true);
----
alice	alice	carol

query TT
SELECT resolved_by_login,closure_request_reviewer_login FROM engineering.detail.secret_scanning_alerts(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>2,secret_scanning_hide_secret=>true);
----
bob	bob

query IT
SELECT alert_number,secret FROM engineering.detail.secret_scanning_alerts(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>1,secret_scanning_hide_secret=>true);
----
1	NULL

# Location occurrences span pages and include all thirteen resource alternatives.
query II
SELECT secret_scanning_alert_count,secret_scanning_location_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha');
----
3	15

query I
SELECT secret_scanning_location_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>1);
----
14

query TI
SELECT secret_scanning_locations_location_type,secret_scanning_location_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha') GROUP BY secret_scanning_locations_location_type ORDER BY secret_scanning_locations_location_type;
----
commit	3
discussion_body	1
discussion_comment	1
discussion_title	1
issue_body	1
issue_comment	1
issue_title	1
pull_request_body	1
pull_request_comment	1
pull_request_review	1
pull_request_review_comment	1
pull_request_title	1
wiki_commit	1

query II
SELECT alert_number,location_ordinal FROM engineering.detail.secret_scanning_locations(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>2);
----
2	1

query I
SELECT secret_scanning_location_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>3);
----
0

# This counts one latest-scan snapshot, not the five nested scan observations or history.
query I
SELECT secret_scanning_scan_snapshot_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha');
----
1

query II
SELECT secret_scanning_bypass_request_count,secret_scanning_bypass_approved_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha');
----
2	1

query II
SELECT secret_scanning_bypass_request_count,secret_scanning_bypass_approved_count FROM engineering.semantic.github(organization=>'secret-fixture');
----
3	1

query TI
SELECT secret_scanning_bypass_requests_status,secret_scanning_bypass_request_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha') GROUP BY secret_scanning_bypass_requests_status ORDER BY secret_scanning_bypass_requests_status;
----
approved	1
completed	1

query IIT
SELECT request_id,request_number,requester_login FROM engineering.detail.secret_scanning_bypass_requests(repository=>'secret-fixture/alpha',secret_scanning_bypass_number=>41);
----
801	41	alice

query I
SELECT secret_scanning_bypass_request_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_bypass_status=>'completed');
----
1

query II
SELECT secret_scanning_dismissal_request_count,secret_scanning_dismissal_approved_count FROM engineering.semantic.github(organization=>'secret-fixture');
----
2	1

# Alert number 2 resolves request number 91, not request number 2.
query IIT
SELECT request_id,request_number,resource_identifier FROM engineering.detail.secret_scanning_dismissal_requests(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>2);
----
901	91	2

query II
SELECT secret_scanning_custom_pattern_count,secret_scanning_protected_pattern_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha');
----
2	1

query II
SELECT secret_scanning_custom_pattern_count,secret_scanning_protected_pattern_count FROM engineering.semantic.github(organization=>'secret-fixture');
----
2	1

query TII
SELECT secret_scanning_custom_patterns_scope_kind,secret_scanning_custom_patterns_scope_id,secret_scanning_custom_pattern_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha') GROUP BY secret_scanning_custom_patterns_scope_kind,secret_scanning_custom_patterns_scope_id;
----
repository	1011	2

query TII
SELECT secret_scanning_custom_patterns_scope_kind,secret_scanning_custom_patterns_scope_id,secret_scanning_custom_pattern_count FROM engineering.semantic.github(organization=>'secret-fixture') GROUP BY secret_scanning_custom_patterns_scope_kind,secret_scanning_custom_patterns_scope_id;
----
organization	1010	2

query I
SELECT secret_scanning_custom_pattern_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_pattern_state=>'published');
----
1

query I
SELECT secret_scanning_custom_pattern_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_pattern_push_protection=>'disabled');
----
1

query IT
SELECT organization_id,pattern_config_version FROM engineering.detail.secret_scanning_pattern_configurations(organization=>'secret-fixture');
----
1010	config-1

query TII
SELECT repository_name,secret_scanning_alert_count,secret_scanning_bypass_request_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha') GROUP BY repository_name;
----
secret-fixture/alpha	3	2

query IIIII
SELECT secret_scanning_alert_count,secret_scanning_location_count,secret_scanning_bypass_request_count,secret_scanning_custom_pattern_count,secret_scanning_scan_snapshot_count FROM engineering.semantic.github(repository=>'secret-fixture/empty');
----
0	0	0	0	1

# Incompatible selectors reject before HTTP.
statement ok
SET crossfield_mode='off';

statement ok
COPY (SELECT '' AS path, '' AS query) TO '{CROSSFIELD_GITHUB_API_LOG}' (FORMAT JSON);

statement ok
SET crossfield_mode='strict';

statement error
SELECT secret_scanning_alert_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_alert_number=>1,secret_scanning_state=>'open');
----
arguments do not apply

statement error
SELECT secret_scanning_bypass_request_count FROM engineering.semantic.github(repository=>'secret-fixture/alpha',secret_scanning_bypass_number=>41,secret_scanning_bypass_status=>'approved');
----
arguments do not apply

statement ok
SET crossfield_mode='off';

query I
SELECT count(*) FROM read_json_auto('{CROSSFIELD_GITHUB_API_LOG}') WHERE path<>'';
----
0

statement ok
DETACH engineering;

statement ok
DETACH github;
