# Release alpha has a draft, a prerelease, one stable release, and three assets.
# Asset byte sizes are 0, 100 and 200; lifetime download counters are 0, 3 and 5.
statement ok
PREPARE github_release_inventory AS
SELECT release_count, published_release_count, draft_release_count, prerelease_count,
       release_asset_count, release_asset_size_bytes, release_asset_download_count
FROM engineering.semantic.github(repository => $1);

query IIIIIII
EXECUTE github_release_inventory('release-fixture/alpha');
----
3	2	1	1	3	300	8

query IIIIIII
EXECUTE github_release_inventory('release-fixture/beta');
----
1	1	0	0	1	400	7

# Three run identities include one success, one failure and one unfinished run.
# Four jobs span attempts; two failed. Four retained artifacts total 75 bytes.
statement ok
PREPARE github_ci_outcomes AS
SELECT workflow_run_count, workflow_run_success_count, workflow_run_failure_count,
       workflow_job_count, workflow_job_failure_count,
       workflow_artifact_count, workflow_artifact_bytes
FROM engineering.semantic.github(repository => $1);

query IIIIIII
EXECUTE github_ci_outcomes('example/alpha');
----
3	1	1	4	2	4	75

# Two suites contain three runs and four annotation occurrences, two failures.
statement ok
PREPARE github_check_results AS
SELECT check_suite_count, check_run_count, successful_check_run_count,
       failed_check_run_count, unfinished_check_run_count,
       check_annotation_count, failure_annotation_count
FROM engineering.semantic.github(repository => $1, git_ref => $2);

query IIIIIII
EXECUTE github_check_results('example/alpha', 'main');
----
2	3	1	1	1	4	2

query IIIIIII
EXECUTE github_check_results('example/empty', 'main');
----
0	0	0	0	0	0	0

