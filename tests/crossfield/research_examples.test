# Independent retrieval oracle: alpha has three issues including a deleted author,
# two discussions, three conversation comments, six threaded discussion comments,
# and two commit comments. Author selection keeps canonical Alice records only.
statement ok
PREPARE github_repository_activity AS
SELECT pull_request_count, issue_count, discussion_count,
       issue_comment_count, discussion_comment_count, commit_comment_count
FROM engineering.semantic.github(repository => $1, user => $2);

query IIIIII
EXECUTE github_repository_activity('example/alpha', NULL);
----
3	3	2	3	6	2

query IIIIII
EXECUTE github_repository_activity('example/alpha', 'alice');
----
2	1	1	1	2	1

query IIIIII
EXECUTE github_repository_activity('example/empty', NULL);
----
0	0	0	0	0	0

