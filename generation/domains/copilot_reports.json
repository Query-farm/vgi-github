  "functions": [
    {
      "name": "copilot_report_metadata",
      "description": "Available organization Copilot report metadata observations, qualified by organization, report population and the returned day/window. One-day endpoints can return204 when no report is available. download_links may contain multiple signed links; links are not users, usage events or completions. Downloaded payload schemas are not supplied by the pinned API, so this entity does not claim usage-row coverage and never follows arbitrary signed URLs automatically. Latest windows are response-derived and can overlap across snapshots.",
      "grain": [
        "organization_id",
        "report_kind",
        "report_start_day",
        "report_end_day"
      ],
      "semantics": {
        "detail_fields": [
          "organization_id",
          "organization_login",
          "report_kind",
          "requested_day",
          "report_start_day",
          "report_end_day",
          "download_links"
        ],
        "dimensions": [
          "organization_id",
          "organization_login",
          "report_kind",
          "requested_day",
          "report_start_day",
          "report_end_day"
        ],
        "sql_names": {
          "organization_id": "copilot_report_metadata_organization_id",
          "organization_login": "copilot_report_metadata_organization_login",
          "report_kind": "copilot_report_metadata_report_kind",
          "requested_day": "copilot_report_metadata_requested_day",
          "report_start_day": "copilot_report_metadata_report_start_day",
          "report_end_day": "copilot_report_metadata_report_end_day"
        },
        "metrics": [
          {
            "name": "available_copilot_report_count",
            "kind": "count",
            "comment": "Available typed report metadata records;204 contributes zero."
          }
        ],
        "crossfield": {
          "metrics": {
            "copilot_report_download_link_count": {
              "expression": "SUM(length(copilot_report_metadata.download_links))"
            }
          },
          "metric_semantics": {
            "copilot_report_download_link_count": {
              "dataset": "copilot_report_metadata",
              "comment": "Signed download links advertised by available reports, not downloaded files or usage rows.",
              "additivity": "additive",
              "missing": "zero"
            }
          }
        }
      },
      "routes": [
        {
          "name": "organization_day",
          "select": [
            "copilot_report_kind"
          ],
          "select_values": {
            "copilot_report_kind": [
              "organization_day"
            ]
          },
          "arguments": [
            {
              "name": "organization",
              "type": "VARCHAR",
              "nullable": false,
              "min_length": 1,
              "description": "Explicit GitHub organization scope. Mutually exclusive with owner and repository.",
              "example": "Query-farm"
            },
            {
              "name": "copilot_report_kind",
              "type": "VARCHAR",
              "nullable": false,
              "min_length": 1,
              "enum": [
                "organization_day",
                "organization_latest",
                "repositories_day",
                "user_teams_day",
                "users_day",
                "users_latest"
              ],
              "example": "organization_day",
              "description": "Copilot report metadata population: organization, repository, user/team mapping or user detail, for one requested day or the latest 28-day window. These endpoints return report links, not usage rows."
            },
            {
              "name": "copilot_report_day",
              "type": "DATE",
              "nullable": false,
              "example": "2026-09-01",
              "description": "Exact UTC report day required by one-day Copilot report endpoints."
            }
          ],
          "columns": [
            {
              "name": "organization_id",
              "source_stage": "organizations",
              "source_column": "organization_id"
            },
            {
              "name": "organization_login",
              "source_stage": "organizations",
              "source_column": "organization_login"
            },
            {
              "name": "report_kind",
              "source_stage": "records",
              "source_column": "report_kind"
            },
            {
              "name": "requested_day",
              "source_stage": "records",
              "source_column": "requested_day"
            },
            {
              "name": "report_start_day",
              "source_stage": "records",
              "source_column": "report_start_day"
            },
            {
              "name": "report_end_day",
              "source_stage": "records",
              "source_column": "report_end_day"
            },
            {
              "name": "download_links",
              "source_stage": "records",
              "source_column": "download_links"
            }
          ],
          "traversal": {
            "stages": [
              {
                "name": "organizations",
                "entity": "organization_lookup",
                "arguments": {
                  "organization": {
                    "parameter": "organization"
                  }
                }
              },
              {
                "name": "records",
                "entity": "organization_copilot_organization_day_report_source",
                "arguments": {
                  "organization": {
                    "stage": "organizations",
                    "column": "organization_login"
                  },
                  "copilot_report_kind": {
                    "literal": "organization_day"
