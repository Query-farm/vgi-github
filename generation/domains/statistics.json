  "functions": [
    {
      "name": "repository_code_frequency",
      "description": "Weekly upstream additions/deletions tuples. The signed deletion value is preserved as reported. Available only for repositories with fewer than 10,000 commits; 422 fails. A 202 pending computation fails rather than becoming an empty population; explicit bodyless 204 is empty. Week values remain Unix seconds without an invented calendar conversion.",
      "grain": [
        "repository_id",
        "week_epoch"
      ],
      "cohort_root": "repositories",
      "routes": [
        {
          "name": "repositories",
          "arguments": [
            {
              "name": "owner",
              "type": "VARCHAR",
              "nullable": true,
              "default": null,
              "min_length": 1,
              "description": "GitHub organization or user owner; user listings contain public owned repositories only. Mutually exclusive with repository and organization.",
              "example": "Query-farm"
            },
            {
              "name": "repository",
              "type": "VARCHAR",
              "nullable": true,
              "default": null,
              "min_length": 1,
              "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
              "example": "Query-farm/crossfield"
            },
            {
              "name": "organization",
              "type": "VARCHAR",
              "nullable": true,
              "default": null,
              "min_length": 1,
              "description": "Explicit GitHub organization scope. Mutually exclusive with owner and repository.",
              "example": "Query-farm"
            }
          ],
          "columns": [
            {
              "name": "repository_id",
              "source_stage": "records",
              "source_column": "repository_id"
            },
            {
              "name": "repository",
              "source_stage": "records",
              "source_column": "repository"
            },
            {
              "name": "week_epoch",
              "source_stage": "records",
              "source_column": "week_epoch"
            },
            {
              "name": "additions",
              "source_stage": "records",
              "source_column": "additions"
            },
            {
              "name": "deletions",
              "source_stage": "records",
              "source_column": "deletions"
            }
          ],
          "traversal": {
            "stages": [
              {
                "name": "repositories",
                "scope": "repositories"
              },
              {
                "name": "records",
                "entity": "repository_code_frequency_source",
                "arguments": {
                  "repository": {
                    "stage": "repositories",
                    "column": "repository"
                  },
                  "repository_id": {
                    "stage": "repositories",
                    "column": "repository_id"
                  }
                }
              }
            ],
            "output_stage": "records"
          },
          "population": "Weekly upstream additions/deletions tuples. The signed deletion value is preserved as reported. Available only for repositories with fewer than 10,000 commits; 422 fails. A 202 pending computation fails rather than becoming an empty population; explicit bodyless 204 is empty. Week values remain Unix seconds without an invented calendar conversion."
        }
      ],
      "semantics": {
        "detail_fields": [
          "repository_id",
          "repository",
          "week_epoch",
          "additions",
          "deletions"
        ],
        "dimensions": [
          "repository",
          "week_epoch"
        ],
        "sql_names": {
          "repository": "repository_code_frequency_repository",
          "week_epoch": "repository_code_frequency_week_epoch"
        },
        "metrics": [
          {
            "name": "repository_code_frequency_week_count",
            "kind": "count",
            "comment": "Returned repository code frequency observations; not an independent count of Git commits or users."
          }
        ],
        "crossfield": {
          "metrics": {
            "repository_code_frequency_additions": {
              "expression": "COALESCE(SUM(repository_code_frequency.additions), 0)"
            },
            "repository_code_frequency_signed_deletions": {
              "expression": "COALESCE(SUM(repository_code_frequency.deletions), 0)"
            }
          },
          "metric_semantics": {
            "repository_code_frequency_additions": {
              "dataset": "repository_code_frequency",
              "additivity": "additive",
              "comment": "Reported additions in distinct selected weekly tuples.",
              "missing": "zero"
            },
            "repository_code_frequency_signed_deletions": {
              "dataset": "repository_code_frequency",
              "additivity": "additive",
              "comment": "Signed upstream deletion values, with no sign inversion.",
              "missing": "zero"
            }
          }
        }
      }
    },
