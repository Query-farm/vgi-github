{
  "entities": [
    {
      "name": "repository_changes_source",
      "description": "repos/list-activities pinned typed repository source.",
      "arguments": [
        {
          "name": "repository",
          "type": "VARCHAR",
          "nullable": false,
          "min_length": 1,
          "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
          "example": "Query-farm/crossfield"
        },
        {
          "name": "repository_id",
          "type": "BIGINT",
          "nullable": false,
          "description": "Stable repository numeric identity hydrated before repository observations.",
          "example": 1
        },
        {
          "name": "repository_activity_ref",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Repository change history ref filter; full ref such as refs/heads/main.",
          "example": "refs/heads/main",
          "default": null
        },
        {
          "name": "repository_activity_actor",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Repository change history actor login filter; distinct from repository owner.",
          "example": "octocat",
          "default": null
        },
        {
          "name": "repository_activity_period",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Repository change history relative time window; omission preserves the API default.",
          "example": "month",
          "default": null,
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        },
        {
          "name": "repository_activity_type",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Repository change history operation type.",
          "example": "push",
          "default": null,
          "enum": [
            "push",
            "force_push",
            "branch_creation",
            "branch_deletion",
            "pr_merge",
            "merge_queue_merge"
          ]
        },
        {
          "name": "repository_activity_direction",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Repository change history ordering.",
          "example": "desc",
          "default": null,
          "enum": [
            "asc",
            "desc"
          ]
        },
        {
          "name": "repository_activity_before",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Opaque repository activity cursor selecting results before a known cursor.",
          "example": "opaque-before",
          "default": null
        },
        {
          "name": "repository_activity_after",
          "type": "VARCHAR",
          "nullable": true,
          "min_length": 1,
          "description": "Opaque repository activity cursor selecting results after a known cursor.",
          "example": "opaque-after",
          "default": null
        }
      ],
      "columns": [
