{
  "entities": [
    {
      "name": "repository_agent_tasks_source",
      "description": "Complete Link-paginated task discovery; hydrate each task through its matching full-detail endpoint. Envelope active/archive totals describe separate populations and are not used as filtered row-count guarantees.",
      "arguments": [
        {
          "name": "repository",
          "type": "VARCHAR",
          "nullable": false,
          "min_length": 1,
          "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
          "example": "Query-farm/crossfield"
        },
        {
          "name": "agent_task_states",
          "type": "VARCHAR",
          "nullable": true,
          "description": "Comma-separated task states to select; omitted means any state within the chosen archived population.",
          "default": null,
          "min_length": 1,
          "example": "completed,failed"
        },
        {
          "name": "agent_task_archived",
          "type": "BOOLEAN",
          "nullable": true,
          "description": "Select archived tasks when true, or active non-archived tasks when false or omitted.",
          "default": null,
          "example": false
        },
        {
          "name": "agent_task_since",
          "type": "TIMESTAMP WITH TIME ZONE",
          "nullable": true,
          "description": "Only tasks updated at or after this instant.",
          "default": null,
          "example": "2026-09-01T00:00:00Z"
        },
        {
          "name": "agent_task_sort",
          "type": "VARCHAR",
          "nullable": true,
          "description": "API task ordering field; ordering does not limit the fully paginated population.",
          "enum": [
            "updated_at",
            "created_at"
          ],
          "default": null,
          "min_length": 1,
          "example": "updated_at"
        },
        {
          "name": "agent_task_direction",
          "type": "VARCHAR",
          "nullable": true,
          "description": "API task ordering direction; ordering does not limit the fully paginated population.",
          "enum": [
            "asc",
            "desc"
          ],
          "default": null,
          "min_length": 1,
          "example": "desc"
        },
        {
          "name": "agent_task_creator_ids",
          "type": "BIGINT[]",
          "nullable": true,
          "description": "Repository task creator user IDs; serialized as repeated creator_id query parameters.",
          "default": null,
          "example": [
            8101,
            8102
          ]
        }
      ],
      "columns": [
        {
          "name": "repository",
          "source_argument": "repository"
        },
        {
          "name": "task_id",
          "path": [
            "id"
          ]
        }
      ],
      "grain": [
        "task_id"
      ],
      "transport": {
        "kind": "rest",
        "product": "api.github.com",
        "operation_id": "agent-tasks/list-tasks-for-repo",
        "path_bindings": {
          "owner": {
            "argument": "repository",
            "transform": "repository_owner"
          },
          "repo": {
            "argument": "repository",
            "transform": "repository_name"
          }
        },
        "query_bindings": {
          "per_page": {
            "literal": 100
          },
          "state": {
            "argument": "agent_task_states"
          },
          "is_archived": {
            "argument": "agent_task_archived"
          },
          "since": {
            "argument": "agent_task_since"
          },
          "sort": {
            "argument": "agent_task_sort"
          },
          "direction": {
            "argument": "agent_task_direction"
          },
          "creator_id": {
            "argument": "agent_task_creator_ids"
          }
        },
        "result_path": [
          "tasks"
        ],
        "result_shape": "array",
        "pagination": {
          "kind": "link"
        }
      }
    },
