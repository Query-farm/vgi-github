  "functions": [
    {
      "name": "agent_tasks",
      "description": "Canonical agent tasks identified by globally unique task ID. Repository and authenticated routes hydrate full details, including typed artifact alternatives and session observations. The listing defaults to non-archived tasks; archived tasks require explicit selection. Global responses supply optional numeric repository and actor IDs, without account logins or repository full names; unknown names stay NULL and no unsupported ID-to-name endpoint is invented. Creator, repository owner and nested session user are separate roles. Session billing units remain typed detail and are not combined into a usage metric.",
      "grain": [
        "task_id"
      ],
      "semantics": {
        "detail_fields": [
          "repository",
          "task_id",
          "repository_id",
          "repository_owner_id",
          "creator_id",
          "creator_type",
          "user_collaborators",
          "url",
          "html_url",
          "name",
          "state",
          "session_count",
          "artifacts",
          "archived_at",
          "created_at",
          "updated_at",
          "custom_agent_id",
          "sessions",
          "task_created_day"
        ],
        "dimensions": [
          "task_id",
          "repository",
          "repository_id",
          "repository_owner_id",
          "creator_id",
          "creator_type",
          "state",
          "custom_agent_id",
          "created_at",
          "updated_at",
          "archived_at",
          "task_created_day"
        ],
        "sql_names": {
          "task_id": "agent_tasks_task_id",
          "repository": "agent_tasks_repository",
          "repository_id": "agent_tasks_repository_id",
          "repository_owner_id": "agent_tasks_repository_owner_id",
          "creator_id": "agent_tasks_creator_id",
          "creator_type": "agent_tasks_creator_type",
          "state": "agent_tasks_state",
          "custom_agent_id": "agent_tasks_custom_agent_id",
          "created_at": "agent_tasks_created_at",
          "updated_at": "agent_tasks_updated_at",
          "archived_at": "agent_tasks_archived_at",
          "task_created_day": "agent_tasks_task_created_day"
        },
        "metrics": [
          {
            "name": "agent_task_count",
            "kind": "count",
            "comment": "Enumerated task identities in the explicitly selected population."
          },
          {
            "name": "completed_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "completed"
            },
            "comment": "Tasks whose current API state is completed."
          },
          {
            "name": "failed_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "failed"
            },
            "comment": "Tasks whose current API state is failed."
          },
          {
            "name": "in_progress_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "in_progress"
            },
            "comment": "Tasks whose current API state is in_progress."
          },
          {
            "name": "queued_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "queued"
            },
            "comment": "Tasks whose current API state is queued."
          },
          {
            "name": "waiting_for_user_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "waiting_for_user"
            },
            "comment": "Tasks whose current API state is waiting_for_user."
          },
          {
            "name": "timed_out_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "timed_out"
            },
            "comment": "Tasks whose current API state is timed_out."
          },
          {
            "name": "cancelled_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "cancelled"
            },
            "comment": "Tasks whose current API state is cancelled."
          },
          {
            "name": "idle_agent_task_count",
            "kind": "count",
            "where": {
              "field": "state",
              "op": "eq",
              "value": "idle"
            },
            "comment": "Tasks whose current API state is idle."
          }
        ],
        "derived_fields": [
          {
            "name": "task_created_day",
            "kind": "date",
            "source": "created_at",
            "timezone": "UTC",
            "comment": "UTC date of task creation."
          }
        ],
        "crossfield": {
          "metrics": {
            "reported_agent_session_count": {
              "expression": "SUM(agent_tasks.session_count)"
            },
            "observed_agent_session_count": {
              "expression": "SUM(length(agent_tasks.sessions))"
            },
            "agent_task_artifact_count": {
              "expression": "SUM(length(agent_tasks.artifacts))"
            },
            "archived_agent_task_count": {
              "expression": "COUNT(*) FILTER (WHERE agent_tasks.archived_at IS NOT NULL)"
            }
          },
          "metric_semantics": {
            "reported_agent_session_count": {
              "dataset": "agent_tasks",
              "comment": "Sum of API-reported session counters, which may differ from nested session observations.",
              "additivity": "additive",
              "missing": "zero"
            },
            "observed_agent_session_count": {
              "dataset": "agent_tasks",
              "comment": "Number of observed nested sessions; missing session arrays remain unknown, while empty arrays count zero.",
              "additivity": "additive",
              "missing": "zero"
            },
            "agent_task_artifact_count": {
              "dataset": "agent_tasks",
              "comment": "Typed artifact associations returned with selected tasks, not distinct PRs or branches.",
              "additivity": "additive",
              "missing": "zero"
            },
            "archived_agent_task_count": {
              "dataset": "agent_tasks",
              "comment": "Tasks with a reported archive timestamp; no inferred archive time.",
              "additivity": "additive",
              "missing": "zero"
            }
          }
        }
      },
      "routes": [
        {
          "name": "lookup",
          "select": [
            "agent_task_id"
          ],
          "arguments": [
            {
              "name": "agent_task_id",
              "type": "VARCHAR",
              "nullable": false,
              "description": "Exact globally unique agent task identifier; repository optionally selects the repository-specific lookup endpoint.",
              "min_length": 1,
              "example": "task-001"
            },
            {
              "name": "repository",
              "type": "VARCHAR",
              "nullable": true,
              "min_length": 1,
              "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
              "example": "Query-farm/crossfield",
              "default": null
            }
          ],
          "columns": [
            {
              "name": "repository",
              "source_stage": "records",
              "source_column": "repository"
            },
            {
              "name": "task_id",
              "source_stage": "records",
              "source_column": "task_id"
            },
            {
              "name": "repository_id",
              "source_stage": "records",
              "source_column": "repository_id"
            },
            {
              "name": "repository_owner_id",
              "source_stage": "records",
              "source_column": "repository_owner_id"
            },
            {
              "name": "creator_id",
              "source_stage": "records",
              "source_column": "creator_id"
            },
            {
              "name": "creator_type",
              "source_stage": "records",
              "source_column": "creator_type"
            },
            {
              "name": "user_collaborators",
              "source_stage": "records",
              "source_column": "user_collaborators"
            },
            {
              "name": "url",
              "source_stage": "records",
              "source_column": "url"
            },
            {
              "name": "html_url",
              "source_stage": "records",
              "source_column": "html_url"
            },
            {
              "name": "name",
              "source_stage": "records",
              "source_column": "name"
            },
            {
              "name": "state",
              "source_stage": "records",
              "source_column": "state"
            },
            {
              "name": "session_count",
              "source_stage": "records",
              "source_column": "session_count"
            },
            {
              "name": "artifacts",
              "source_stage": "records",
              "source_column": "artifacts"
            },
            {
              "name": "archived_at",
              "source_stage": "records",
              "source_column": "archived_at"
            },
            {
              "name": "created_at",
              "source_stage": "records",
              "source_column": "created_at"
            },
            {
              "name": "updated_at",
              "source_stage": "records",
              "source_column": "updated_at"
            },
            {
              "name": "custom_agent_id",
              "source_stage": "records",
              "source_column": "custom_agent_id"
            },
            {
              "name": "sessions",
              "source_stage": "records",
              "source_column": "sessions"
            }
          ],
          "traversal": {
            "stages": [
              {
                "name": "records",
                "scope": "agent_task_lookup"
              }
            ],
            "output_stage": "records"
          },
          "population": "One globally identified task. Supplying repository uses the repository-scoped API; omitting it uses the authenticated global task lookup. Listing filters are deliberately not accepted by lookup."
        },
        {
          "name": "authenticated",
          "select": [
            "authenticated_user"
          ],
          "arguments": [
            {
              "name": "authenticated_user",
              "type": "BOOLEAN",
              "nullable": false,
              "enum": [
                true
              ],
              "example": true,
              "description": "Select the authenticated personal account using GitHub /user endpoints; never infer the account from ambient login names."
            },
            {
              "name": "agent_task_states",
              "type": "VARCHAR",
              "nullable": true,
              "description": "Comma-separated task states to select; omitted means any state within the chosen archived population.",
