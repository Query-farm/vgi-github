{
  "crossfield": {
    "invocations": {
      "sources": {
        "pull_request_reviews": {
          "dataset": {
            "fields": {
              "review_latency_hours": {
                "expression": "DATEDIFF('millisecond', pull_request_reviews.pull_request_created_at, pull_request_reviews.submitted_at) / 3600000.0",
                "type": "DOUBLE",
                "unit": "h"
              },
              "review_submitted_eastern_day": {
                "expression": "CAST(pull_request_reviews.review_submitted_eastern AS DATE)",
                "type": "DATE",
                "dimension": true,
                "is_time": true,
                "calendar": "gregorian",
                "granularity": "day"
              }
            }
          }
        },
        "authored_pull_requests": {
          "dataset": {
            "fields": {
              "authored_pr_created_eastern_day": {
                "expression": "CAST(authored_pull_requests.authored_pr_created_eastern AS DATE)",
                "type": "DATE",
                "dimension": true,
                "is_time": true,
                "calendar": "gregorian",
                "granularity": "day"
              }
            }
          }
        }
      },
