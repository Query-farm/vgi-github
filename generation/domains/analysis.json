      "metric_semantics": {
        "pr_first_review_hours": {
          "comment": "Earliest submitted review latency per selected PR group; use first_review_prs for a distribution with one observation per PR.",
          "additivity": "non_additive",
          "dataset": "pull_request_reviews",
          "population": "pull_request_reviews.submitted_at IS NOT NULL AND pull_request_reviews.state IN ('APPROVED', 'CHANGES_REQUESTED', 'COMMENTED', 'DISMISSED')",
          "population_id": "github/submitted-review-with-time/v1",
          "unit": "h"
        },
        "pr_first_review_at": {
          "comment": "Earliest eligible review submission instant. Missing timestamps and pending states are excluded.",
          "additivity": "non_additive",
          "dataset": "pull_request_reviews",
          "population": "pull_request_reviews.submitted_at IS NOT NULL AND pull_request_reviews.state IN ('APPROVED', 'CHANGES_REQUESTED', 'COMMENTED', 'DISMISSED')",
          "population_id": "github/submitted-review-with-time/v1",
          "timezone": "UTC"
        },
        "reviewed_pr_count": {
          "comment": "PRs with at least one submitted, timestamped review. Each PR contributes once regardless of review count.",
          "additivity": "additive",
          "dataset": "first_review_prs"
        },
        "mean_first_review_hours": {
          "comment": "Equal weight per reviewed PR; averages the first review latency, not all review records. Unreviewed PRs are excluded.",
          "additivity": "non_additive",
          "dataset": "first_review_prs",
          "unit": "h"
        },
        "median_first_review_hours": {
          "comment": "Median first-review latency across reviewed PRs; one observation per PR.",
          "additivity": "non_additive",
          "dataset": "first_review_prs",
          "unit": "h"
        },
        "p90_first_review_hours": {
          "comment": "Continuous 90th percentile of first-review latency across reviewed PRs; one observation per PR.",
          "additivity": "non_additive",
          "dataset": "first_review_prs",
          "unit": "h"
        },
        "review_record_count": {
          "comment": "All returned review records, including pending records; used before the explicit submitted-review stage filter.",
          "additivity": "additive",
          "dataset": "pull_request_reviews"
        },
        "review_record_state": {
          "comment": "Review state at the unique review-record grain; used only to carry its value into the submitted-review stage.",
          "additivity": "non_additive",
          "dataset": "pull_request_reviews"
        },
        "review_record_login": {
          "comment": "Reviewer login at unique review-record grain; the stable numeric reviewer ID controls identity.",
          "additivity": "non_additive",
          "dataset": "pull_request_reviews"
        },
        "review_latest_rank": {
          "comment": "Latest submitted review per PR and reviewer, ordered by instant and then greatest review ID for deterministic timestamp ties.",
          "additivity": "non_additive",
          "dataset": "submitted_reviews",
          "window_grain": [
            "submitted_reviews.repository_id",
            "submitted_reviews.pull_request_number",
            "submitted_reviews.reviewer_id",
            "submitted_reviews.review_id",
            "submitted_reviews.submitted_at"
          ]
        },
        "submitted_review_state": {
          "comment": "Submitted state at a unique review ID, retained for latest-review selection.",
          "additivity": "non_additive",
          "dataset": "submitted_reviews"
        },
        "submitted_reviewer_login": {
          "comment": "Reviewer login at a unique submitted review ID; not the PR author.",
          "additivity": "non_additive",
          "dataset": "submitted_reviews"
        },
        "latest_reviewer_review_count": {
          "comment": "PR/reviewer pairs with an observed submitted review; the latest record is selected before this count.",
          "additivity": "additive",
          "dataset": "latest_reviewer_reviews"
        },
        "latest_approved_reviewer_count": {
          "comment": "PR/reviewer pairs whose latest submitted record is APPROVED; not distinct people across PRs and not GitHub merge eligibility.",
          "additivity": "additive",
          "dataset": "latest_reviewer_reviews"
        },
        "monthly_authored_pr_total": {
          "comment": "Visible authored PR total for this user and UTC creation month across all repository groups in the selected population.",
          "additivity": "non_additive",
          "window_grain": [
            "authored_pull_requests.user_id",
            "authored_pull_requests.user_login",
            "authored_pull_requests.authored_pr_created_month",
            "authored_pull_requests.repository_node_id",
            "authored_pull_requests.repository_name"
          ]
        },
        "monthly_repository_pr_share": {
          "comment": "Repository share of a user's visible authored PRs in a UTC creation month. Denominator is formed before QUALIFY or output LIMIT; no claim about invisible repositories or contribution quality.",
          "additivity": "non_additive",
          "window_grain": [
            "authored_pull_requests.user_id",
            "authored_pull_requests.user_login",
            "authored_pull_requests.authored_pr_created_month",
            "authored_pull_requests.repository_node_id",
            "authored_pull_requests.repository_name"
          ]
        },
        "monthly_user_pr_rank": {
          "comment": "Dense rank of selected users by observed authored-PR count in each UTC creation month. Ties share rank; users with no observed PRs are absent. This is activity volume, not performance or impact.",
          "additivity": "non_additive",
          "window_grain": [
            "authored_pull_requests.user_id",
            "authored_pull_requests.user_login",
            "authored_pull_requests.authored_pr_created_month"
          ]
        }
      },
