    "metrics": {
      "pr_first_review_hours": {
        "expression": "MIN(pull_request_reviews.review_latency_hours)"
      },
      "pr_first_review_at": {
        "expression": "MIN(pull_request_reviews.submitted_at)"
      },
      "reviewed_pr_count": {
        "expression": "COUNT(*)"
      },
      "mean_first_review_hours": {
        "expression": "AVG(first_review_prs.first_review_hours)"
      },
      "median_first_review_hours": {
        "expression": "MEDIAN(first_review_prs.first_review_hours)"
      },
      "p90_first_review_hours": {
        "expression": "PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY first_review_prs.first_review_hours)"
      },
      "review_record_count": {
        "expression": "COUNT(*)"
      },
      "review_record_state": {
        "expression": "MAX(pull_request_reviews.state)"
      },
      "review_record_login": {
        "expression": "MAX(pull_request_reviews.reviewer_login)"
      },
      "review_latest_rank": {
        "expression": "ROW_NUMBER() OVER (PARTITION BY submitted_reviews.repository_id, submitted_reviews.pull_request_number, submitted_reviews.reviewer_id ORDER BY submitted_reviews.submitted_at DESC, submitted_reviews.review_id DESC)"
      },
      "submitted_review_state": {
        "expression": "MAX(submitted_reviews.state)"
      },
      "submitted_reviewer_login": {
        "expression": "MAX(submitted_reviews.reviewer_login)"
      },
      "latest_reviewer_review_count": {
        "expression": "COUNT(*)"
      },
      "latest_approved_reviewer_count": {
        "expression": "COUNT(*) FILTER (WHERE latest_reviewer_reviews.state = 'APPROVED')"
      },
      "monthly_authored_pr_total": {
        "expression": "SUM(authored_pr_count) OVER (PARTITION BY authored_pull_requests.user_id, authored_pull_requests.user_login, authored_pull_requests.authored_pr_created_month)"
      },
      "monthly_repository_pr_share": {
        "expression": "authored_pr_count / NULLIF(monthly_authored_pr_total, 0)"
      },
      "monthly_user_pr_rank": {
        "expression": "DENSE_RANK() OVER (PARTITION BY authored_pull_requests.authored_pr_created_month ORDER BY authored_pr_count DESC)"
      }
    },
