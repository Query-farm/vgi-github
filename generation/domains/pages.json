              "source_column": "https_enforced"
            }
          ],
          "traversal": {
            "stages": [
              {
                "name": "repositories",
                "scope": "repositories"
              },
              {
                "name": "records",
                "entity": "pages_site_source",
                "arguments": {
                  "repository": {
                    "stage": "repositories",
                    "column": "repository"
                  },
                  "repository_id": {
                    "stage": "repositories",
                    "column": "repository_id"
