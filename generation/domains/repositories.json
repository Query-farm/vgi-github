  "functions": [
    {
      "name": "repositories",
      "description": "Canonical visible repository inventory. Organization scopes follow credential visibility; user scopes list PUBLIC owned repositories only.",
      "arguments": [
        {
          "name": "owner",
          "type": "VARCHAR",
          "nullable": true,
          "default": null,
          "min_length": 1,
          "description": "GitHub organization or user owner; user listings contain public owned repositories only. Mutually exclusive with repository and organization.",
          "example": "Query-farm"
        },
        {
          "name": "repository",
          "type": "VARCHAR",
          "nullable": true,
          "default": null,
          "min_length": 1,
          "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
          "example": "Query-farm/crossfield"
        },
        {
          "name": "organization",
          "type": "VARCHAR",
          "nullable": true,
          "default": null,
          "min_length": 1,
          "description": "Explicit GitHub organization scope. Mutually exclusive with owner and repository.",
          "example": "Query-farm"
        }
      ],
      "columns": [
