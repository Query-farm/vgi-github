  "scopes": {
    "repositories": {
      "exclusive_parameters": [
        "owner",
        "repository",
        "organization"
      ],
      "comment": "Choose exactly one repository, owner or organization. Organization listings follow credential visibility; user-owner listings contain public owned repositories only.",
      "select": {
        "parameter": "repository",
        "if_present": {
          "entity": "repository_lookup",
          "arguments": {
            "repository": {
              "parameter": "repository"
            }
          }
        },
        "if_absent": {
          "parameter": "organization",
          "if_present": {
            "entity": "organization_repositories",
            "arguments": {
              "owner": {
                "parameter": "organization"
              }
            }
          },
          "if_absent": {
            "resolve": {
              "entity": "account_lookup",
              "arguments": {
                "owner": {
                  "parameter": "owner"
                }
              }
            },
            "field": "account_type",
            "cases": {
              "Organization": {
                "entity": "organization_repositories",
                "arguments": {
                  "owner": {
                    "parameter": "owner"
                  }
                }
              },
              "User": {
                "entity": "user_repositories",
                "arguments": {
                  "owner": {
                    "parameter": "owner"
                  }
                }
              }
            }
          }
        }
      }
    },
    "pull_requests": {
      "requires_parameters": {
        "pull_request_number": [
          "repository"
        ]
      },
      "comment": "A PR number narrows one repository to one PR. Without it, include all current open and closed PR records.",
      "select": {
        "parameter": "pull_request_number",
        "if_present": {
          "entity": "pull_request_lookup",
          "arguments": {
            "repository": {
              "stage": "repositories",
              "column": "repository"
            },
            "pull_request_number": {
              "parameter": "pull_request_number"
            }
          }
        },
        "if_absent": {
          "entity": "pull_request_list",
          "arguments": {
            "repository": {
              "stage": "repositories",
              "column": "repository"
            }
          }
        }
      }
    }
