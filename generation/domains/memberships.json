      "metric_semantics": {
        "repository_topic_membership_count": {
          "dataset": "repository_topics",
          "additivity": "additive",
          "missing": "zero",
          "comment": "Current repository-topic memberships in the selected repository/owner/organization population. Counts membership pairs; one parent can contribute to several memberships."
        },
        "repositories_with_topic_count": {
          "dataset": "repository_topics",
          "additivity": "non_additive",
          "missing": "zero",
          "comment": "Current repository-topic memberships in the selected repository/owner/organization population. Distinct parents represented by the selected memberships; excludes parents with no returned memberships. Never sum this count across membership groups."
        },
        "pull_request_label_membership_count": {
          "dataset": "pull_request_labels",
          "additivity": "additive",
          "missing": "zero",
          "comment": "Current PR-label memberships; different labels may share a name, so use label_id for identity. Counts membership pairs; one parent can contribute to several memberships."
        },
        "labeled_pull_request_count": {
          "dataset": "pull_request_labels",
          "additivity": "non_additive",
          "missing": "zero",
          "comment": "Current PR-label memberships; different labels may share a name, so use label_id for identity. Distinct parents represented by the selected memberships; excludes parents with no returned memberships. Never sum this count across membership groups."
        },
        "pull_request_assignee_membership_count": {
          "dataset": "pull_request_assignees",
          "additivity": "additive",
          "missing": "zero",
          "comment": "Current PR-assignee memberships; assignment does not establish authorship, review or team contribution. Counts membership pairs; one parent can contribute to several memberships."
        },
        "assigned_pull_request_count": {
          "dataset": "pull_request_assignees",
          "additivity": "non_additive",
          "missing": "zero",
          "comment": "Current PR-assignee memberships; assignment does not establish authorship, review or team contribution. Distinct parents represented by the selected memberships; excludes parents with no returned memberships. Never sum this count across membership groups."
        }
      },
      "field_semantics": {
        "repository_topics.topic": {
          "sql_name": "repository_topic",
          "comment": "Current topic string; a repository can have multiple topics."
        },
        "pull_request_labels.label_id": {
          "sql_name": "pr_label_id",
          "comment": "Stable identity of an assigned repository label."
        },
        "pull_request_labels.label_name": {
          "sql_name": "pr_label_name",
          "comment": "Current assigned label name; names are not unique across repositories."
        },
        "pull_request_assignees.assignee_id": {
          "sql_name": "pr_assignee_id",
          "comment": "Account identity of a current PR assignee; distinct from author/reviewer roles."
        },
        "pull_request_assignees.assignee_login": {
          "sql_name": "pr_assignee_login",
          "comment": "Current login of a PR assignee."
        }
