  "functions": [
    {
      "name": "repository_contents",
      "description": "Canonical repository content objects, unifying explicit path/root and preferred README retrieval. Grain is stable repository ID plus returned path and content/tree SHA; requested refs are selectors, not extra identities. Encoded content stays VARCHAR with its declared encoding, never falsely decoded as complete bytes. Object-media files of 1\u2013100 MB may report encoding=none and empty content; over 100 MB is unsupported. Directory entries are immediate children only, fail at the 1,000-entry ceiling, and remain NULL/unknown when absent. Submodules may be reported as file and symlinks may return their file target, so reported_type is not a definitive Git object classification. Expiring download URLs are descriptive and never automatically followed. Use Git trees for recursive listings. The object-media pinned schema omits symlink target/submodule URL; those fields are NULL on the path route, even if undocumented extra response keys exist.",
      "grain": [
        "repository_id",
        "content_path",
        "content_sha"
      ],
      "cohort_root": "repositories",
      "nullable_route_fields": [
        "entries",
        "symlink_target",
        "submodule_git_url"
      ],
