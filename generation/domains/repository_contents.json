              "example": "Query-farm"
            },
            {
              "name": "repository",
              "type": "VARCHAR",
              "nullable": true,
              "default": null,
              "min_length": 1,
              "description": "One repository as owner/name. Mutually exclusive with owner and organization.",
              "example": "Query-farm/crossfield"
            },
            {
              "name": "organization",
              "type": "VARCHAR",
              "nullable": true,
              "default": null,
              "min_length": 1,
              "description": "Explicit GitHub organization scope. Mutually exclusive with owner and repository.",
              "example": "Query-farm"
            },
            {
              "name": "readme_directory",
              "type": "VARCHAR",
              "nullable": false,
