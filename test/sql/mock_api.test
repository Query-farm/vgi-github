# name: test/sql/mock_api.test
# description: REST, GraphQL and typed functions against test/mock_api/server.py
#   (ci/run-integration.sh starts it and points VGI_GITHUB_MOCK_WORKER at it).
# group: [sql]

require-env VGI_GITHUB_MOCK_WORKER

require vgi

statement ok
LOAD json;

statement ok
ATTACH 'github' AS github (TYPE vgi, LOCATION '{VGI_GITHUB_MOCK_WORKER}', auth 'off');

# A generated REST function under a correlated LATERAL join.
query IT
SELECT t.n, p.data::JSON ->> 'path' FROM (VALUES (1), (2)) t(n), LATERAL github.rest.pulls_get('o', 'r', t.n) p ORDER BY t.n;
----
1	/api/v3/repos/o/r/pulls/1
2	/api/v3/repos/o/r/pulls/2

# Query parameters pass through as JSON.
query T
SELECT data::JSON ->> 'path' FROM github.rest.repos_list_for_authenticated_user(query => '{"visibility":"private"}');
----
/api/v3/user/repos?visibility=private

# A non-JSON media type comes back as raw bytes.
query T
SELECT rtrim(decode(body), chr(10)) FROM github.rest.pulls_get('o', 'r', 1, accept => 'application/vnd.github.diff');
----
diff --git a/a b/a

# The generic REST entry point, by operation id.
query T
SELECT data::JSON ->> 'path' FROM github.api.rest('pulls/list-reviews', '{"owner":"o","repo":"r","pull_number":7}');
----
/api/v3/repos/o/r/pulls/7/reviews

query T
SELECT data::JSON -> 'data' -> 'echo' ->> 'value' FROM github.api.graphql('query Read($value:String) { viewer { login } }', '{"value":"ok"}');
----
ok

# Typed GraphQL tables paginate (two one-row pages) and chain under LATERAL.
query ITTTTT
SELECT d.number, d.title, d.is_answered, c.node_id, r.reply_to_id, r.body FROM github.discussions('o/r', answered => false, max_rows => 0) d, LATERAL github.discussion_comments(d.repo, d.number, max_rows => 1) c, LATERAL github.discussion_replies(c.node_id, max_rows => 1) r ORDER BY d.number;
----
1	Question 1	false	C_1	C_1	Reply
2	Question 2	false	C_2	C_2	Reply
